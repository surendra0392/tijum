APP_NAME=TIJUM
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tijum
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax # Keep 'lax' so session cookies persist across 3D-Secure bank payment redirects

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.tijum.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@tijum.com
MAIL_PASSWORD=YOUR_SMTP_PASSWORD
MAIL_FROM_ADDRESS="no-reply@tijum.com"
MAIL_FROM_NAME="TIJUM"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret
RAZORPAY_MODE=test
TIJUM_PAYMENT_GATEWAY=razorpay
TIJUM_PAYMENTS_LIVE_ENABLED=false
TIJUM_CHECKOUT_EXPIRY_MINUTES=15
TIJUM_PARTNER_SETTLEMENTS_ENABLED=false
TIJUM_RAZORPAY_ROUTE_ENABLED=false
TIJUM_SETTLEMENT_HOLD_HOURS=24

TIJUM_NOTIFICATIONS_ENABLED=true
TIJUM_DATABASE_NOTIFICATIONS_ENABLED=true
TIJUM_EMAIL_ENABLED=true
TIJUM_SMS_ENABLED=false
TIJUM_WHATSAPP_ENABLED=false
TIJUM_SMS_PROVIDER=msg91
TIJUM_SMS_AUTH_KEY=
TIJUM_SMS_SENDER_ID=TIJUMS
TIJUM_SMS_DLT_PE_ID=
TIJUM_SMS_WEBHOOK_SECRET=
TIJUM_SMS_MODE=test
TIJUM_WHATSAPP_PHONE_NUMBER_ID=
TIJUM_WHATSAPP_WABA_ID=
TIJUM_WHATSAPP_ACCESS_TOKEN=
TIJUM_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
TIJUM_WHATSAPP_APP_SECRET=
TIJUM_WHATSAPP_GRAPH_VERSION=v21.0
TIJUM_WHATSAPP_MODE=test
TIJUM_NOTIFICATION_RETENTION_DAYS=90


