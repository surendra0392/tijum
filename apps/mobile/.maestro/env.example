# TIJUM Mobile Maestro E2E Test Environment Configuration
# Copy to `.maestro/.env.local` (git-ignored) or supply via CI secrets / `-e KEY=VALUE`.
# NEVER point MAESTRO_API_URL at production (`https://tijum.com/api/v1`) and NEVER commit real passwords.

# Isolated local/staging API endpoint seeded via `php scripts/seed_mobile_qa.php`
MAESTRO_API_URL=http://10.0.2.2:8091/api/v1

# Customer fixture credentials (provisioned at test runtime by isolated seeder)
MAESTRO_CUSTOMER_EMAIL=customer@tijum.com
MAESTRO_CUSTOMER_PASSWORD=CHANGE_ME_AT_RUNTIME

# Partner fixture credentials (provisioned at test runtime by isolated seeder)
MAESTRO_PARTNER_EMAIL=owner@tijum.com
MAESTRO_PARTNER_PASSWORD=CHANGE_ME_AT_RUNTIME

# Deterministic seeded fixture identifiers (printed by `php scripts/seed_mobile_qa.php`)
MAESTRO_PROPERTY_ID=1
MAESTRO_PROPERTY_NAME=Sri Sai Balaji Executive Hostel & PG
MAESTRO_UPCOMING_BOOKING_REF=TJR-2026-UPCOMING-01
MAESTRO_TODAY_BOOKING_REF=TJR-2026-TODAY-QA02

# Per-run unique mutation markers (override in CI with run timestamp/ID)
MAESTRO_CASE_MARKER=MAESTRO-CASE-VERIFY-01
MAESTRO_NEW_PROPERTY_NAME=Maestro Verified Residency QA
MAESTRO_NEW_ROOM_NUMBER=M-401
MAESTRO_KYC_PAN=ABCDE1234F
MAESTRO_KYC_IFSC=HDFC0001234
MAESTRO_KYC_ACCOUNT=50100123454892
